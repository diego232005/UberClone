{
  "expo": {
    "name": "UberCloneConductor",
    "slug": "UberCloneConductor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para mostrar el mapa y enviar tu posición mientras estás disponible.",
        "NSCameraUsageDescription": "Para fotos de perfil, vehículo y documentos.",
        "NSPhotoLibraryUsageDescription": "Para seleccionar fotos de perfil, vehículo y documentos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-location",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir acceso a fotos para el registro del conductor."
        }
      ]
    ],
    "extra": {
      "USE_MOCK": "true"
    }
  }
}
